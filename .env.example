# ── Payload CMS ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local development uses SQLite (no setup required).
# For production, swap to Postgres and use the connection string, e.g.
#   DATABASE_URI=postgres://user:pass@host/db
DATABASE_URI=file:./wavecare-cms.db

# Used for canonical URLs, sitemap entries and live-preview links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── GoHighLevel (contact form → CRM) ─────────────────────────
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Analytics (all optional; blank disables the script) ──────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
