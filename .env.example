# ── Payload CMS ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# The adapter is chosen from this value — no code change needed.
#   file:./name.db                -> SQLite (zero setup, local development only)
#   libsql://name-org.turso.io    -> Turso (hosted SQLite; also set DATABASE_AUTH_TOKEN)
#   postgres://user:pass@host/db  -> Postgres (Neon, Supabase, RDS, ...)
#
# IMPORTANT: SQLite cannot ALTER existing tables, so every schema change means
# dropping and re-seeding the database. That destroys real editor work. Use
# Postgres as soon as anyone is editing content for real:
#   1. create a database (Neon's free tier is enough)
#   2. set DATABASE_URI below to its connection string
#   3. npm run migrate:create
#   4. npm run seed
DATABASE_URI=file:./wavecare-cms.db

# Required only when DATABASE_URI is a libsql:// (Turso) URL.
#   turso db tokens create wavecare
DATABASE_AUTH_TOKEN=

# Used for canonical URLs, sitemap entries and live-preview links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── CMS admin bootstrap ──────────────────────────────────────
# Used once by `npm run seed` to create the first administrator.
# No NEXT_PUBLIC_ prefix, so Next.js never inlines these into a client bundle.
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Minimum 16 characters — the seed refuses anything shorter.
ADMIN_USERNAME=WavecareAdmin
ADMIN_INITIAL_PASSWORD=

# ── GoHighLevel (contact form → CRM) ─────────────────────────
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Analytics (all optional; blank disables the script) ──────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Second, newer Google Ads account (coexists with NEXT_PUBLIC_GADS_ID above —
# both get their own gtag('config', ...) call). Conversion fires only from
# the contact form's success handler, never on page load or button click.
NEXT_PUBLIC_GADS_CONVERSION_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=
# Phone-call conversion label — only fires the phone_conversion_number
# gtag('config') call in layout.tsx when this is set.
NEXT_PUBLIC_GADS_CALL_LABEL=

# PostHog. NEXT_PUBLIC_POSTHOG_KEY is used both by the client-side snippet
# (layout.tsx) and the server-side client (lib/posthog-server.ts, used by
# /api/contact for the lead_created event) — same key, one var. Found
# 2026-08-26: posthog-server.ts previously read a different, never-set var
# name and silently sent every server-side event with no API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Media storage (Vercel's filesystem is ephemeral — pick one) ──
# S3 takes priority over Vercel Blob when S3_BUCKET is set (see
# payload.config.ts). Region and endpoint are path-style (not
# virtual-hosted), matching this project's generateFileURL.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Fallback storage, used only when S3_BUCKET is not set.
BLOB_READ_WRITE_TOKEN=
